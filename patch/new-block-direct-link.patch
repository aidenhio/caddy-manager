From 46dc02ff285d41d82576c72eef78b9418dbcd8c1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 19:33:16 +1100
Subject: [PATCH] New site block links straight to /new; remove type pop-up

The universal block form has its own type picker, so the Overview and
Site blocks "New site block" buttons now link to /new and the
new_block_modal partial is removed. Quick Add still uses /new/<type>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GFYvS9tgNsRjfuEB4vjX1t
---
 templates/home.html                     |  8 ++----
 templates/partials/new_block_modal.html | 36 -------------------------
 templates/site_blocks.html              |  8 ++----
 3 files changed, 4 insertions(+), 48 deletions(-)
 delete mode 100644 templates/partials/new_block_modal.html

diff --git a/templates/home.html b/templates/home.html
index 030ca5a..d454b25 100644
--- a/templates/home.html
+++ b/templates/home.html
@@ -11,21 +11,17 @@
 {% block header_actions %}
 <div class="btn-list">
   {% include 'partials/quick_add_button.html' %}
-  <button type="button" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-blocks">
+  <a href="{{ url_for('main.new_block') }}" class="btn btn-primary d-none d-sm-inline-block">
     <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2">
       <path d="M12 5l0 14"></path>
       <path d="M5 12l14 0"></path>
     </svg>
     New site block
-  </button>
+  </a>
 </div>
 {% endblock %}
 
-{% block page_modal %}
-{% include 'partials/new_block_modal.html' %}
-{% endblock %}
-
