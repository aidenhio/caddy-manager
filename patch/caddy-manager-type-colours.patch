diff --git a/app.py b/app.py
index 7112a68..0cc7c79 100644
--- a/app.py
+++ b/app.py
@@ -18,6 +18,31 @@ CONFIG_PATH = os.path.join(BASE_DIR, "config.json")
 app = Flask(__name__)
 
 
+# ---------------------------------------------------------------------------
+# Block type colors — the single place block-type -> Tabler color is defined.
+# Templates get this as the `type_color(block_type)` Jinja global below, so
+# every page/badge/button stays in sync if a color ever changes here.
+# `primary` is reserved for generic UI elements (nav, page buttons, etc.) and
+# is never used to represent a block type.
+# ---------------------------------------------------------------------------
+TYPE_COLORS = {
+    "reverse_proxy": "azure",
+    "redirect": "purple",
+    "load_balancer": "pink",
+    "custom": "yellow",
+}
+DEFAULT_TYPE_COLOR = TYPE_COLORS["custom"]
+
+
+def type_color(block_type):
+    return TYPE_COLORS.get(block_type, DEFAULT_TYPE_COLOR)
+
+
+@app.context_processor
+def inject_type_color():
+    return dict(type_color=type_color)
+
+
 # ---------------------------------------------------------------------------
 # Config helpers (a JSON file stands in for a database — there's very little
 # to store: the admin credentials, the caddy.d directory, and a session key)
