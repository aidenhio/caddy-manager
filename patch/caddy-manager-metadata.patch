diff --git a/templates/block_form.html b/templates/block_form.html
new file mode 100644
index 0000000..9e7a97c
--- /dev/null
+++ b/templates/block_form.html
@@ -0,0 +1,143 @@
+{% extends "base.html" %}
+
+{% block title %}
+  {% if mode == 'edit' %}Edit {{ filename }}{% else %}New Site{% endif %} - Caddy Manager
+{% endblock %}
+{% block page_pretitle %}Caddy{% endblock %}
+{% block page_title %}{% if mode == 'edit' %}Edit Site{% else %}New Site{% endif %}{% endblock %}
+
+{% block header_actions %}
+{% endblock %}
+
+<!---->
+
+{% block content %}
+
+<!-- BEGIN BLOCK FORM CARD -->
+<div class="row">
+  <div class="col">
+    <div class="card">
+
+      <!-- BEGIN CARD HEADER -->
+      <div class="card-header">
+        <h3 class="card-title">
+          {% if mode == 'edit' %}
+            Editing <span class="badge bg-lt font-monospace">{{ filename }}</span>
+          {% elif block_type == 'reverse_proxy' %}New Reverse Proxy Block
+          {% elif block_type == 'redirect' %}New Redirect Block
+          {% elif block_type == 'load_balancer' %}New Load Balancer Block
+          {% else %}New Custom Block{% endif %}
+        </h3>
+      </div>
+      <!-- END CARD HEADER -->
+
+      <!-- BEGIN CARD BODY -->
+      <div class="card-body">
+        {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
+
+        <form method="post">
+
+          <!-- BEGIN DOMAIN / LABEL FIELD -->
+          {% if block_type == 'custom' %}
+          <div class="mb-3">
+            <label class="form-label">Label <span class="form-hint d-inline">(optional — used only to name the file)</span></label>
+            <input type="text" name="domain" id="domain" class="form-control" value="{{ meta.domain or '' }}" placeholder="app.example.com">
+          </div>
+          {% else %}
+          <div class="mb-3">
+            <label class="form-label">Domain/host</label>
+            <input type="text" name="domain" id="domain" class="form-control" value="{{ meta.domain or '' }}" placeholder="app.example.com" required>
+          </div>
+          {% endif %}
+          <!-- END DOMAIN / LABEL FIELD -->
+
+          <!-- BEGIN REVERSE PROXY FIELDS -->
+          {% if block_type == 'reverse_proxy' %}
+          <div class="row">
+            <div class="col-md-3 mb-3">
+              <label class="form-label">Scheme</label>
+              <select name="scheme" class="form-select">
+                <option value="" {{ 'selected' if not meta.scheme }}>(default)</option>
+                <option value="http" {{ 'selected' if meta.scheme == 'http' }}>http</option>
+                <option value="https" {{ 'selected' if meta.scheme == 'https' }}>https</option>
+              </select>
+            </div>
+            <div class="col-md-6 mb-3">
+              <label class="form-label">Host</label>
+              <input type="text" name="host" class="form-control" value="{{ meta.host or '' }}" placeholder="127.0.0.1" required>
+            </div>
+            <div class="col-md-3 mb-3">
+              <label class="form-label">Port</label>
+              <input type="text" name="port" class="form-control" value="{{ meta.port or '' }}" placeholder="8080">
+            </div>
+          </div>
+          <div class="mb-3">
+            <label class="form-label">Extra directives <span class="form-hint d-inline">(optional, one per line, inside the block)</span></label>
+            <textarea name="extra" class="form-control" rows="4" style="font-family:var(--tblr-font-monospace, monospace)" placeholder="header_up X-Real-IP {remote_host}">{{ meta.extra or '' }}</textarea>
+          </div>
+          {% endif %}
+          <!-- END REVERSE PROXY FIELDS -->
+
+          <!-- BEGIN LOAD BALANCER FIELDS -->
+          {% if block_type == 'load_balancer' %}
+          <div class="mb-3">
+            <label class="form-label">Upstreams <span class="form-hint d-inline">(one per line, at least two — e.g. 10.0.0.1:8080)</span></label>
+            <textarea name="upstreams" class="form-control" rows="4" style="font-family:var(--tblr-font-monospace, monospace)" placeholder="10.0.0.1:8080&#10;10.0.0.2:8080" required>{{ upstreams_text }}</textarea>
+          </div>
+          <div class="mb-3">
+            <label class="form-label">Load balancing policy</label>
+            <select name="lb_policy" class="form-select">
+              {% for policy in ['round_robin', 'least_conn', 'random', 'ip_hash', 'uri_hash', 'header', 'first'] %}
+              <option value="{{ policy }}" {{ 'selected' if meta.lb_policy == policy }}>{{ policy }}</option>
+              {% endfor %}
+            </select>
+          </div>
+          <div class="mb-3">
+            <label class="form-label">Extra directives <span class="form-hint d-inline">(optional, one per line, inside the reverse_proxy block)</span></label>
+            <textarea name="extra" class="form-control" rows="4" style="font-family:var(--tblr-font-monospace, monospace)">{{ meta.extra or '' }}</textarea>
+          </div>
+          {% endif %}
+          <!-- END LOAD BALANCER FIELDS -->
+
+          <!-- BEGIN REDIRECT FIELDS -->
+          {% if block_type == 'redirect' %}
+          <div class="mb-3">
+            <label class="form-label">Redirect target</label>
+            <input type="text" name="target" class="form-control" value="{{ meta.target or '' }}" placeholder="https://new.example.com{uri}" required>
+          </div>
+          <div class="mb-3">
+            <label class="form-label">Redirect code</label>
+            <select name="redirect_code" class="form-select">
+              {% for code, label in [('301','301 (Permanent)'), ('302','302 (Temporary)'), ('307','307 (Temporary, preserve method)'), ('308','308 (Permanent, preserve method)')] %}
+              <option value="{{ code }}" {{ 'selected' if (meta.redirect_code or '301') == code }}>{{ label }}</option>
+              {% endfor %}
+            </select>
+          </div>
+          {% endif %}
+          <!-- END REDIRECT FIELDS -->
+
+          <!-- BEGIN CUSTOM FIELDS -->
+          {% if block_type == 'custom' %}
+          <div class="mb-3">
+            <label class="form-label">Full block content</label>
+            <textarea name="raw_content" id="raw_content" class="form-control" rows="12" style="font-family:var(--tblr-font-monospace, monospace)" placeholder="app.example.com {&#10;    reverse_proxy 127.0.0.1:8080&#10;    encode gzip&#10;}" required></textarea>
+          </div>
+          {% endif %}
+          <!-- END CUSTOM FIELDS -->
+
+          <!-- BEGIN FORM ACTIONS -->
+          <div class="form-footer d-flex gap-2">
+            <button type="submit" class="btn btn-primary">{{ 'Save Changes' if mode == 'edit' else 'Create Block' }}</button>
+            <a href="{{ url_for('sites') }}" class="btn">Cancel</a>
+          </div>
+          <!-- END FORM ACTIONS -->
+
+        </form>
+      </div>
+      <!-- END CARD BODY -->
+    </div>
+  </div>
+</div>
+<!-- END BLOCK FORM CARD -->
+
+{% endblock %}
