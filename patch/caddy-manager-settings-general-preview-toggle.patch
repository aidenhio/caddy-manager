From bfa88f699af835c04ee307e147a5bfdea36e26e4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 07:13:08 +0000
Subject: [PATCH] Move log tail length and cert expiry threshold into General
 settings; add a metadata card toggle for the Preview page

- The "Log tail length" and "Expiring soon threshold" options are app
  behavior, not Caddy configuration, so they move from their own
  Logging/Certificates tabs into the General tab. Those two tabs are
  removed from Settings since they had no other content.
- Add a "Show Metadata card" toggle to General's Preview Page Options
  section, defaulted to on, controlling whether a block's Preview page
  displays the raw metadata sidecar alongside the Caddy config.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GdhKf193j6ggwAGFYCUaJg
---
 caddy_manager/configstore.py |  15 +++++
 caddy_manager/views.py       |   8 +++
 templates/preview.html       |   4 +-
 templates/settings.html      | 127 ++++++++++++++++++-----------------
 4 files changed, 90 insertions(+), 64 deletions(-)

diff --git a/caddy_manager/configstore.py b/caddy_manager/configstore.py
index d15ddc2..562c469 100644
--- a/caddy_manager/configstore.py
+++ b/caddy_manager/configstore.py
@@ -142,3 +142,18 @@ def get_quick_add_type_site_blocks():
     cfg = load_config()
     value = cfg.get("quick_add_type_site_blocks") if cfg else None
     return value if value in QUICK_ADD_BLOCK_TYPES else None
+
+
+# Whether a block's Preview page shows the raw metadata sidecar alongside its
+# Caddy config -- on by default, since the metadata card is how someone
+# double-checks what the app has stored about a block (creation time, log
+# settings, etc.) without opening the sidecar file directly.
+DEFAULT_SHOW_METADATA_CARD = True
+
+
+def get_show_metadata_card():
+    cfg = load_config()
+    value = cfg.get("show_metadata_card") if cfg else None
+    if isinstance(value, bool):
+        return value
+    return DEFAULT_SHOW_METADATA_CARD
