From d693888007b70be752ebad51e4a738b30b3bd1ba Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Wed, 26 Aug 2026 08:44:39 +0000
Subject: [PATCH] Refresh all metadata sidecars once at login

- Added blocks.refresh_all_metadata(): cleans up any orphaned .metadata
  sidecars, then reads (and, via read_metadata()'s existing self-heal,
  re-parses/re-writes if stale) every .conf/.conf.disabled file's
  metadata. Called once from auth.login() right after a successful login,
  so anything changed outside the app since the last visit -- a
  hand-edited block, a .conf dropped in, renamed, or removed directly --
  is already reflected before the user reaches the site blocks list or a
  preview page, rather than only self-healing lazily, file by file, the
  next time each one happens to be read.
- Extracted the .conf/.conf.disabled globbing (previously inlined in
  list_blocks()) into a small _conf_paths() helper shared by both
  list_blocks() and refresh_all_metadata(), so there's one place that
  decides what counts as a block file.

Verified: created a block through the app, logged out, then edited its
.conf directly on disk (changing its upstream host and adding a second
site address) and dropped in an unrelated brand-new .conf with no sidecar
at all -- confirmed both were stale/missing beforehand, then logging back
in brought both fully up to date (including creating the missing sidecar)
before ever touching /site-blocks or /preview. Also checked login still
works cleanly when the caddy directory doesn't exist (or is removed
after setup). Full create/edit/preview/toggle/settings regression across
all four block types still passes, and pyflakes is clean.
---
 caddy_manager/auth.py   |  6 ++++++
 caddy_manager/blocks.py | 26 +++++++++++++++++++++++---
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/caddy_manager/auth.py b/caddy_manager/auth.py
index 6eebc66..9c01a8a 100644
--- a/caddy_manager/auth.py
+++ b/caddy_manager/auth.py
@@ -8,6 +8,7 @@ from flask import Blueprint, render_template, request, redirect, url_for, sessio
 from werkzeug.security import generate_password_hash, check_password_hash
 
 from .configstore import load_config, save_config, is_configured
+from .blocks import refresh_all_metadata
 
 bp = Blueprint("auth", __name__)
 
@@ -77,6 +78,11 @@ def login():
         if username == cfg["username"] and check_password_hash(cfg["password_hash"], password):
             session["logged_in"] = True
             session["username"] = username
+            # Catch up on anything changed outside the app since the last
+            # visit before the user reaches the site blocks list or a
+            # preview page, rather than relying on each file self-healing
+            # only when it happens to be read.
+            refresh_all_metadata()
             return redirect(url_for("main.dashboard"))
         error = "Invalid username or password."
     return render_template("login.html", error=error)
diff --git a/caddy_manager/blocks.py b/caddy_manager/blocks.py
index e1d4510..99d73a2 100644
--- a/caddy_manager/blocks.py
+++ b/caddy_manager/blocks.py
@@ -174,14 +174,34 @@ def cleanup_orphaned_metadata():
 # Listing
 # ---------------------------------------------------------------------------
 
-def list_blocks():
+def _conf_paths():
+    """Every .conf/.conf.disabled file path in the caddy dir, or [] if
+    that directory doesn't exist yet."""
     caddy_dir = get_caddy_dir()
     if not os.path.isdir(caddy_dir):
         return []
-    cleanup_orphaned_metadata()
-    paths = glob.glob(os.path.join(caddy_dir, "*.conf")) + \
+    return glob.glob(os.path.join(caddy_dir, "*.conf")) + \
         glob.glob(os.path.join(caddy_dir, "*.conf.disabled"))
 
+
+def refresh_all_metadata():
+    """Bring every block's metadata sidecar up to date: clean up any
+    orphaned sidecars, then read (and, via read_metadata's own self-heal,
+    re-parse/re-write if stale) every .conf/.conf.disabled file's
+    metadata. Called once at login so anything changed outside the app
+    since the last visit -- a hand-edited block, or a .conf dropped in,
+    renamed, or removed directly -- is already reflected before the user
+    reaches the site blocks list or a preview page, rather than only
+    self-healing lazily, file by file, as each happens to be viewed."""
+    cleanup_orphaned_metadata()
+    for path in _conf_paths():
+        read_metadata(os.path.basename(path), path)
+
+
+def list_blocks():
+    cleanup_orphaned_metadata()
+    paths = _conf_paths()
+
     blocks = []
     for path in paths:
         fname = os.path.basename(path)
