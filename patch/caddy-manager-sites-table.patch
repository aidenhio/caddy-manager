+<!-- BEGIN SITES TABLE CONTROLS STYLES/SCRIPT -->
+<style>
+  .table-sort-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    background: none;
+    border: none;
+    padding: 0;
+    margin: 0;
+    color: inherit;
+    font: inherit;
+    font-weight: inherit;
+    cursor: pointer;
+  }
+  .table-sort-btn .sort-icon {
+    font-size: 0.8rem;
+    opacity: 0.35;
+  }
+  .table-sort-btn.sort-active .sort-icon {
+    opacity: 1;
+    color: var(--tblr-primary);
+  }
+  .type-filter-chip {
+    cursor: pointer;
+    opacity: 0.45;
+    border: 1px solid transparent;
+    user-select: none;
+  }
+  .type-filter-chip.active {
+    opacity: 1;
+    border-color: currentColor;
+  }
+</style>
+<script>
+  (function () {
+    const table = document.getElementById('sites-table');
+    if (!table) return;
+
+    const tbody = table.querySelector('tbody');
+    const rows = Array.from(tbody.querySelectorAll('tr[data-type]'));
+    const pageSizeSelect = document.getElementById('sites-page-size');
+    const filterChips = Array.from(document.querySelectorAll('.type-filter-chip'));
+    const sortButtons = Array.from(document.querySelectorAll('.table-sort-btn'));
+    const summaryEl = document.getElementById('sites-page-summary');
+    const indicatorEl = document.getElementById('sites-page-indicator');
+    const prevBtn = document.getElementById('sites-prev-page');
+    const nextBtn = document.getElementById('sites-next-page');
+
+    const state = {
+      page: 1,
+      pageSize: parseInt(pageSizeSelect.value, 10) || 20,
+      sortKey: null,
+      sortType: 'text',
+      sortDir: 'asc',
+      activeTypes: new Set(),
+    };
+
+    function getFiltered() {
+      if (state.activeTypes.size === 0) return rows.slice();
+      return rows.filter((r) => state.activeTypes.has(r.dataset.type));
+    }
+
+    function compareRows(a, b) {
+      if (!state.sortKey) return 0;
+      let av = a.dataset[state.sortKey] || '';
+      let bv = b.dataset[state.sortKey] || '';
+      if (state.sortType === 'number') {
+        av = parseFloat(av) || 0;
+        bv = parseFloat(bv) || 0;
+        if (av === bv) return 0;
+        return state.sortDir === 'asc' ? av - bv : bv - av;
+      }
+      av = av.toLowerCase();
+      bv = bv.toLowerCase();
+      if (av === bv) return 0;
+      const cmp = av < bv ? -1 : 1;
+      return state.sortDir === 'asc' ? cmp : -cmp;
+    }
+
+    function updateSortIndicators() {
+      sortButtons.forEach((btn) => {
+        const icon = btn.querySelector('.sort-icon');
+        const active = btn.dataset.sortKey === state.sortKey;
+        btn.classList.toggle('sort-active', active);
+        icon.className = 'ti sort-icon ' + (
+          !active ? 'ti-arrows-sort' : state.sortDir === 'asc' ? 'ti-sort-ascending' : 'ti-sort-descending'
+        );
+      });
+    }
+
+    function render() {
+      const filtered = getFiltered().sort(compareRows);
+      const total = filtered.length;
+      const totalPages = Math.max(1, Math.ceil(total / state.pageSize));
+      if (state.page > totalPages) state.page = totalPages;
+      if (state.page < 1) state.page = 1;
+
+      const start = total === 0 ? 0 : (state.page - 1) * state.pageSize;
+      const end = Math.min(start + state.pageSize, total);
+
+      // Reorder every filtered row into the sorted order, then show only
+      // the current page's slice; rows excluded by the filter just hide.
+      filtered.forEach((r) => tbody.appendChild(r));
+      rows.forEach((r) => { r.style.display = 'none'; });
+      filtered.slice(start, end).forEach((r) => { r.style.display = ''; });
+
+      summaryEl.textContent = total === 0
+        ? 'No sites match the current filter.'
+        : `Showing ${start + 1}\u2013${end} of ${total} site${total === 1 ? '' : 's'}`;
+      indicatorEl.textContent = `Page ${state.page} of ${totalPages}`;
+      prevBtn.disabled = state.page <= 1;
+      nextBtn.disabled = state.page >= totalPages;
+
+      updateSortIndicators();
+    }
+
+    filterChips.forEach((chip) => {
+      chip.addEventListener('click', () => {
+        const type = chip.dataset.type;
+        if (state.activeTypes.has(type)) {
+          state.activeTypes.delete(type);
+          chip.classList.remove('active');
+        } else {
+          state.activeTypes.add(type);
+          chip.classList.add('active');
+        }
+        state.page = 1;
+        render();
+      });
+      chip.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          chip.click();
+        }
+      });
+    });
+
+    sortButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const key = btn.dataset.sortKey;
+        if (state.sortKey === key) {
+          state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
+        } else {
+          state.sortKey = key;
+          state.sortType = btn.dataset.sortType || 'text';
+          state.sortDir = 'asc';
+        }
+        render();
+      });
+    });
+
+    pageSizeSelect.addEventListener('change', () => {
+      state.pageSize = parseInt(pageSizeSelect.value, 10) || 20;
+      state.page = 1;
+      render();
+    });
+
+    prevBtn.addEventListener('click', () => {
+      state.page -= 1;
+      render();
+    });
+
+    nextBtn.addEventListener('click', () => {
+      state.page += 1;
+      render();
+    });
+
+    render();
+  })();
+</script>
+<!-- END SITES TABLE CONTROLS STYLES/SCRIPT -->
 {% endblock %}
 