From 468467f07dc6d0a84b4aaa1db2b7acd55bdadfa2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 19:29:57 +1100
Subject: [PATCH] feat: show only invalid fields in form validation, in full
 red

- initFormValidation flags invalid fields with .is-invalid instead of
  adding .was-validated, so valid fields get no green border or icon
- flags stay live from the first Save and clear on reset
- block form tab dots key off the new validated marker
- invalid colour uses the normal red in dark mode too

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GFYvS9tgNsRjfuEB4vjX1t
---
 static/css/override.css    |  9 ++++++++-
 static/js/block-form.js    | 14 +++++++++-----
 static/js/form-validate.js | 27 +++++++++++++++++++++++----
 3 files changed, 40 insertions(+), 10 deletions(-)

diff --git a/static/css/override.css b/static/css/override.css
index 82f527c..9002368 100644
--- a/static/css/override.css
+++ b/static/css/override.css
@@ -21,4 +21,11 @@
     --tblr-gray-800: #27272a;
     --tblr-gray-900: #18181b;
     --tblr-gray-950: #09090b;
-}
\ No newline at end of file
+}
+
+/* Form validation: Tabler lightens the invalid red in dark mode; use the normal red in both themes. */
+:root,
+[data-bs-theme=dark] {
+    --tblr-form-invalid-color: var(--tblr-red);
+    --tblr-form-invalid-border-color: var(--tblr-red);
+}
diff --git a/static/js/block-form.js b/static/js/block-form.js
index 44819ad..d7b8616 100644
--- a/static/js/block-form.js
+++ b/static/js/block-form.js
@@ -230,11 +230,15 @@
   });
 
   // A red dot on each tab title that holds an invalid field, shown from the first failed Save
-  // (when Bootstrap's was-validated styling kicks in) and kept live as fields are fixed.
-  const invalidSelector = '.is-invalid, :invalid:not(fieldset)';
+  // (when initFormValidation starts flagging fields) and kept live as fields are fixed.
+  const invalidSelector = '.is-invalid';
   function updateTabDots() {
-    const validated = form.classList.contains('was-validated');
-    if (validated && window.__validateSiteAddresses) window.__validateSiteAddresses();
+    const validated = Boolean(form.dataset.validated);
+    if (validated) {
+      // Also covers changes with no input event, like added/removed upstream rows and chips.
+      refreshInvalidFields(form);
+      if (window.__validateSiteAddresses) window.__validateSiteAddresses();
+    }
     form.querySelectorAll('.tab-pane').forEach((pane) => {
       const dot = form.querySelector('[data-bs-target="#' + pane.id + '"] [data-invalid-dot]');
       if (dot) dot.hidden = !(validated && pane.querySelector(invalidSelector));
@@ -254,7 +258,7 @@
   form.addEventListener('submit', (event) => {
     updateTabDots();
     if (!event.defaultPrevented) return;
-    const invalid = form.querySelector('.is-invalid, :invalid:not(fieldset)');
+    const invalid = form.querySelector(invalidSelector);
     const pane = invalid && invalid.closest('.tab-pane');
     if (!pane || pane.classList.contains('active')) return;
     const tabButton = form.querySelector('[data-bs-toggle="tab"][data-bs-target="#' + pane.id + '"]');
diff --git a/static/js/form-validate.js b/static/js/form-validate.js
index 4a13fd3..ad7f80f 100644
--- a/static/js/form-validate.js
+++ b/static/js/form-validate.js
@@ -1,5 +1,14 @@
-// Shared client-side form validation: native HTML5 required/minlength drive
-// Bootstrap's .was-validated styling; extraValidator plugs in fields that can't use `required`.
+// Shared client-side form validation: native HTML5 required/minlength checks, shown with
+// Bootstrap's per-field .is-invalid (not .was-validated, so valid fields stay unstyled).
+// extraValidator plugs in fields that can't use `required`.
+
+// Marks each field that fails its native checks with .is-invalid and clears the rest.
+// Disabled fields (including inside a disabled fieldset) never validate, so they're cleared too.
+function refreshInvalidFields(form) {
+  form.querySelectorAll("input, select, textarea").forEach((field) => {
+    field.classList.toggle("is-invalid", field.willValidate && !field.checkValidity());
+  });
+}
 
 function initFormValidation(form, extraValidator) {
   if (!form) return;
@@ -11,10 +20,20 @@ function initFormValidation(form, extraValidator) {
       event.preventDefault();
       event.stopPropagation();
     }
-    form.classList.add("was-validated");
+    // From the first Save on, invalid fields are flagged and kept up to date as they're edited.
+    form.dataset.validated = "true";
+    refreshInvalidFields(form);
   });
+  const refreshIfValidated = () => {
+    if (form.dataset.validated) refreshInvalidFields(form);
+  };
+  form.addEventListener("input", refreshIfValidated);
+  form.addEventListener("change", refreshIfValidated);
   // A reset restores values but not invalid styling; clear it so the form looks untouched.
-  form.addEventListener("reset", () => form.classList.remove("was-validated"));
+  form.addEventListener("reset", () => {
+    delete form.dataset.validated;
+    form.querySelectorAll(".is-invalid").forEach((field) => field.classList.remove("is-invalid"));
+  });
 }
 
