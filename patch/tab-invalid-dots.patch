From faf394c8c5ca2a89d5d073e6d01c977569cd4b27 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 15:15:05 +1100
Subject: [PATCH] Block form: red dot on tabs that hold invalid fields

Each tab title gets a hidden badge dot. From the first failed Save
(Bootstrap's was-validated state) it shows on every tab with an invalid
field, and updates live as fields are fixed, chips or upstream rows
change, or the block type switches.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GFYvS9tgNsRjfuEB4vjX1t
---
 static/js/block-form.js   | 22 ++++++++++++++++++++++
 templates/block_form.html |  8 ++++----
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/static/js/block-form.js b/static/js/block-form.js
index a4f0383..44819ad 100644
--- a/static/js/block-form.js
+++ b/static/js/block-form.js
@@ -229,8 +229,30 @@
     return window.__validateSiteAddresses ? window.__validateSiteAddresses() : true;
   });
 
+  // A red dot on each tab title that holds an invalid field, shown from the first failed Save
+  // (when Bootstrap's was-validated styling kicks in) and kept live as fields are fixed.
+  const invalidSelector = '.is-invalid, :invalid:not(fieldset)';
+  function updateTabDots() {
+    const validated = form.classList.contains('was-validated');
+    if (validated && window.__validateSiteAddresses) window.__validateSiteAddresses();
+    form.querySelectorAll('.tab-pane').forEach((pane) => {
+      const dot = form.querySelector('[data-bs-target="#' + pane.id + '"] [data-invalid-dot]');
+      if (dot) dot.hidden = !(validated && pane.querySelector(invalidSelector));
+    });
+  }
+  let dotsQueued = false;
+  function queueTabDots() {
+    if (dotsQueued) return;
+    dotsQueued = true;
+    requestAnimationFrame(() => { dotsQueued = false; updateTabDots(); });
+  }
+  // click covers adding/removing chips and upstream rows; change covers the type picker.
+  ['input', 'change', 'click', 'keyup'].forEach((type) => form.addEventListener(type, queueTabDots));
+  form.addEventListener('reset', () => setTimeout(updateTabDots, 0));
+
   // Registered after initFormValidation, so defaultPrevented already reflects its verdict.
   form.addEventListener('submit', (event) => {
+    updateTabDots();
     if (!event.defaultPrevented) return;
     const invalid = form.querySelector('.is-invalid, :invalid:not(fieldset)');
     const pane = invalid && invalid.closest('.tab-pane');
diff --git a/templates/block_form.html b/templates/block_form.html
index ec70f54..2f6ead6 100644
--- a/templates/block_form.html
+++ b/templates/block_form.html
@@ -50,10 +50,10 @@
     <!-- BEGIN SECTION TABS NAV -->
     <div class="col-12">
       <nav class="nav nav-segmented w-100 flex-nowrap overflow-x-auto" role="tablist">
-        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-general" aria-selected="true">General</button>
-        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-advanced" aria-selected="false" tabindex="-1">Advanced</button>
-        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-security" aria-selected="false" tabindex="-1">Security</button>
-        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-logging" aria-selected="false" tabindex="-1">Logging</button>
+        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-general" aria-selected="true">General<span class="badge bg-red ms-2" data-invalid-dot hidden></span></button>
+        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-advanced" aria-selected="false" tabindex="-1">Advanced<span class="badge bg-red ms-2" data-invalid-dot hidden></span></button>
+        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-security" aria-selected="false" tabindex="-1">Security<span class="badge bg-red ms-2" data-invalid-dot hidden></span></button>
+        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#block-tab-logging" aria-selected="false" tabindex="-1">Logging<span class="badge bg-red ms-2" data-invalid-dot hidden></span></button>
       </nav>
     </div>
     <!-- END SECTION TABS NAV -->
