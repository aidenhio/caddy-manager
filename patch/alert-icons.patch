diff --git a/templates/macros/alerts.html b/templates/macros/alerts.html
new file mode 100644
index 0000000..5b8455b
--- /dev/null
+++ b/templates/macros/alerts.html
@@ -0,0 +1,42 @@
+{# Icons match https://preview.tabler.io/alerts.html exactly (alert-circle/alert-triangle/check/info-circle). #}
+{% macro alert_icon(kind) %}
+  {%- if kind == 'danger' -%}
+<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon alert-icon">
+  <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
+  <path d="M12 8v4" />
+  <path d="M12 16h.01" />
+</svg>
+  {%- elif kind == 'warning' -%}
+<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon alert-icon">
+  <path d="M12 9v4" />
+  <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
+  <path d="M12 16h.01" />
+</svg>
+  {%- elif kind == 'success' -%}
+<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon alert-icon">
+  <path d="M5 12l5 5l10 -10" />
+</svg>
+  {%- elif kind == 'info' -%}
+<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon alert-icon">
+  <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
+  <path d="M12 9h.01" />
+  <path d="M11 12h1v4h1" />
+</svg>
+  {%- endif -%}
+{% endmacro %}
+
+{# Full alert with its icon. `kind` is danger/warning/success/info. `dismissible` adds the
+   standard close button; `classes` appends any extra utility classes (e.g. "fade show mb-3").
+   The body is wrapped in one <div> -- .alert is display:flex, so mixed content (text next to
+   a <code>/<a>/etc.) would otherwise split into separate flex columns instead of flowing. #}
+{% macro alert(kind, dismissible=False, classes='') %}
+<div class="alert alert-{{ kind }}{% if dismissible %} alert-dismissible{% endif %}{% if classes %} {{ classes }}{% endif %}" role="alert">
+  <div class="alert-icon">
+    {{ alert_icon(kind) }}
+  </div>
+  <div>{{ caller() }}</div>
+  {% if dismissible %}
+  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
+  {% endif %}
+</div>
+{% endmacro %}
