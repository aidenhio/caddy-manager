+{% extends "base.html" %}
+
+{% block title %}Certificates - Caddy Manager{% endblock %}
+{% block page_pretitle %}Caddy{% endblock %}
+{% block page_title %}Certificates{% endblock %}
+
+{% block header_actions %}
+{% endblock %}
+
+<!---->
+
+{% block content %}
+
+{% if not dir_exists %}
+  <div class="alert alert-danger">The certificates directory doesn't exist yet. Caddy creates it the first time it obtains a certificate.</div>
+{% endif %}
+
+<div class="card">
+  {% if certs %}
+  <!-- BEGIN SEARCH BAR -->
+  <div class="card-header">
+    <div class="row w-full g-2">
+      <div class="col col-4">
+        <div class="input-group input-group-flat w-auto">
+            <span class="input-group-text">
+              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
+                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
+                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
+                <path d="M21 21l-6 -6"></path>
+              </svg>
+            </span>
+            <input id="certificates-search" type="text" class="form-control" autocomplete="off" placeholder="Search…">
+          </div>
+      </div>
+      <div class="ms-auto col-auto">
+        <select id="certificates-page-size" class="form-select">
+          <option value="10" selected>10</option>
+          <option value="20">20</option>
+          <option value="50">50</option>
+          <option value="100">100</option>
+        </select>
+      </div>
+    </div>
+  </div>
+  <!-- END SEARCH BAR -->
+
+  <!-- BEGIN CERTIFICATES TABLE LIST -->
+  <div class="table-responsive" style="min-height: 24rem;">
+    <table class="table card-table table-vcenter" id="certificates-table"
+           data-datatable
+           data-dt-search="#certificates-search"
+           data-dt-page-size="#certificates-page-size"
+           data-dt-page-size-default="10"
+           data-dt-summary="#certificates-page-summary"
+           data-dt-pagination="#certificates-pagination"
+           data-dt-default-sort="cn"
+           data-dt-default-sort-dir="asc"
+           data-dt-storage-key="certificates-table">
+      <thead>
+        <tr>
+          <th>
+            <button type="button" class="table-sort d-flex justify-content-between" data-sort-key="cn" data-sort-type="text">
+              CN
+            </button>
+          </th>
+          <th>
+            <button type="button" class="table-sort d-flex justify-content-between" data-sort-key="provider" data-sort-type="text">
+              Provider
+            </button>
+          </th>
+          <th>
+            <button type="button" class="table-sort d-flex justify-content-between" data-sort-key="expiry" data-sort-type="number">
+              Expiry
+            </button>
+          </th>
+          <th class="w-1"></th>
+        </tr>
+      </thead>
+      <tbody>
+      {% for cert in certs %}
+        <tr data-cn="{{ cert.cn | lower }}" data-provider="{{ cert.provider | lower }}" data-expiry="{{ cert.expiry_ts }}">
+          <td><span class="font-monospace">{{ cert.cn }}</span></td>
+          <!-- BEGIN PROVIDER CELL -->
+          <td>
+            {% if cert.provider.startswith('Local') %}
+              <span class="badge bg-secondary-lt">
+                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-server">
+                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
+                  <path d="M3 4m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" />
+                  <path d="M3 12m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" />
+                  <path d="M7 8l0 .01" />
+                  <path d="M7 16l0 .01" />
+                </svg>
+                {{ cert.provider }}
+              </span>
+            {% elif cert.provider.startswith("Let's Encrypt") %}
+              <span class="badge bg-blue-lt">
+                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-shield-check">
+                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
+                  <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
+                  <path d="M9 12l2 2l4 -4" />
+                </svg>
+                {{ cert.provider }}
+              </span>
+            {% else %}
+              <span class="badge bg-secondary-lt">{{ cert.provider }}</span>
+            {% endif %}
+          </td>
+          <!-- END PROVIDER CELL -->
+          <!-- BEGIN EXPIRY CELL -->
+          <td>
+            <span class="badge {{ 'bg-danger-lt' if (cert.expired or cert.expiring_soon) else 'bg-green-lt' }}">
+              {{ cert.expiry }}{% if cert.expired %} &middot; Expired{% endif %}
+            </span>
+          </td>
+          <!-- END EXPIRY CELL -->
+          <td>
+            <button type="button" class="btn btn-sm" disabled title="Coming soon">
+              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon dropdown-item-icon icons-tabler-outline icon-tabler-eye">
+                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
+                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
+                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
+              </svg>
+              View
+            </button>
+          </td>
+        </tr>
+      {% endfor %}
+      </tbody>
+    </table>
+  </div>
+  <!-- END CERTIFICATES TABLE LIST -->
+
+  <!-- BEGIN PAGINATION BAR -->
+  <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
+    <p class="m-0 text-secondary" id="certificates-page-summary"></p>
+    <ul class="pagination m-0" id="certificates-pagination"></ul>
+  </div>
+  <!-- END PAGINATION BAR -->
+  {% else %}
+  <div class="card-body text-secondary">
+    {% if dir_exists %}
+    No certificates found in <code>{{ certificate_dir }}</code> yet.
+    {% else %}
+    No certificate directory configured yet. Set one in Settings, then Caddy will populate it as it obtains certificates.
+    {% endif %}
+  </div>
+  {% endif %}
+</div>
+{% endblock %}
