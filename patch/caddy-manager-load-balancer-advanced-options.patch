diff --git a/static/js/tooltips.js b/static/js/tooltips.js
new file mode 100644
index 0000000..0a14451
--- /dev/null
+++ b/static/js/tooltips.js
@@ -0,0 +1,10 @@
+// BEGIN BOOTSTRAP TOOLTIP INIT
+// Tabler bundles Bootstrap's JS, but tooltips still need to be explicitly
+// instantiated -- this activates every native data-bs-toggle="tooltip"
+// element on the page once it loads. Runs on every page (included from
+// base.html) so any future tooltip trigger just works without each page
+// needing its own init call.
+(function () {
+  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => new bootstrap.Tooltip(el));
+})();
+// END BOOTSTRAP TOOLTIP INIT
