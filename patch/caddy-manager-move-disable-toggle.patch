-        error=error, conf_dir=get_conf_dir(), log_dir=get_log_dir(), log_dir_display=(get_log_dir() or "<logs dir>").rstrip("/")
+        error=error, conf_dir=get_conf_dir(), log_dir=get_log_dir(), log_dir_display=(get_log_dir() or "<logs dir>").rstrip("/"),
