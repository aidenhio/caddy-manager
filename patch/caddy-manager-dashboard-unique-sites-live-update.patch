@@ -326,15 +326,15 @@
             {% if stats.upstreams_total is not none %}
             <div class="row text-center">
               <div class="col-4">
-                <div class="h1 mb-0">{{ stats.upstreams_total }}</div>
+                <div class="h1 mb-0"><span id="upstream-count-value">{{ stats.upstreams_total }}</span></div>
                 <div class="text-secondary">Upstreams</div>
               </div>
               <div class="col-4">
-                <div class="h1 mb-0">{{ stats.current_requests }}</div>
-                <div class="text-secondary">Requests</div>
+                <div class="h1 mb-0"><span id="requested-sites-value">{{ stats.unique_requested_sites }}</span></div>
+                <div class="text-secondary">Sites</div>
               </div>
               <div class="col-4">
-                <div class="h1 mb-0 {{ 'text-danger' if stats.failed_requests else '' }}">{{ stats.failed_requests }}</div>
+                <div id="failed-requests-wrapper" class="h1 mb-0 {{ 'text-danger' if stats.failed_requests else '' }}"><span id="failed-requests-value">{{ stats.failed_requests }}</span></div>
                 <div class="text-secondary">Failed</div>
               </div>
             </div>
